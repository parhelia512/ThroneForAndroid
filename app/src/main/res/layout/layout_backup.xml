<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_local"
                        android:textAppearance="?attr/textAppearanceHeadline6" />

                    <CheckBox
                        android:id="@+id/backup_profiles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="@string/backup_part_profiles" />

                    <CheckBox
                        android:id="@+id/backup_routes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/backup_part_routes" />

                    <CheckBox
                        android:id="@+id/backup_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/backup_part_settings" />

                    <CheckBox
                        android:id="@+id/backup_icons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/backup_part_icons" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/backup_local_summary"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="?android:attr/textColorSecondary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginVertical="8dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/backup_create"
                        style="@style/Widget.SagerNet.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_create"
                        android:textColor="?whiteOrTextPrimary"
                        app:cornerRadius="24dp" />

                    <Button
                        android:id="@+id/backup_share"
                        style="@style/Widget.SagerNet.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/share"
                        android:textColor="?whiteOrTextPrimary"
                        app:cornerRadius="24dp" />

                    <Button
                        android:id="@+id/backup_restore"
                        style="@style/Widget.SagerNet.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_restore"
                        android:textColor="?whiteOrTextPrimary"
                        app:cornerRadius="24dp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="@string/backup_webdav"
                    android:textAppearance="?attr/textAppearanceHeadline6" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginVertical="8dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/webdav_settings"
                        style="@style/Widget.SagerNet.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/webdav_settings"
                        android:textColor="?whiteOrTextPrimary"
                        app:cornerRadius="24dp" />

                    <Button
                        android:id="@+id/backup_to_webdav"
                        style="@style/Widget.SagerNet.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/backup_to_webdav"
                        android:textColor="?whiteOrTextPrimary"
                        app:cornerRadius="24dp" />

                    <Button
                        android:id="@+id/restore_from_webdav"
                        style="@style/Widget.SagerNet.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/restore_from_webdav"
                        android:textColor="?whiteOrTextPrimary"
                        app:cornerRadius="24dp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
